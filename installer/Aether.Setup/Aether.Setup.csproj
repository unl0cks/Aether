<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aether.Setup</AssemblyName>
    <RootNamespace>Aether.Setup</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Aether.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- THE PAYLOAD.
       Built in two passes by build-setup.ps1:
         1. no AetherPayload  → a bare installer binary. Its only job is to ride along inside the payload as
                                uninstall.exe, so uninstalling doesn't need the installer kept around.
         2. AetherPayload=... → the real setup, with Aether (and that uninstall.exe) compressed inside it.
       A build with no payload still runs; it just uninstalls instead of pretending it can install. -->
  <ItemGroup Condition="'$(AetherPayload)' != ''">
    <EmbeddedResource Include="$(AetherPayload)" LogicalName="Aether.payload" />
  </ItemGroup>

  <!-- THE LAUNCHER FLAG.
       Two of the three builds carry no payload, so "no payload" alone can no longer mean "uninstall":

         no payload, no flag  → the bare build, which becomes uninstall.exe
         no payload, flag set → the launcher, which downloads the published portable zip
         payload              → the full setup, which installs what it carries

       Compiled in rather than passed at runtime, so a build cannot be talked into downloading by an argument.
       Off unless asked for, which is what keeps uninstall.exe an uninstaller. -->
  <PropertyGroup>
    <AetherLauncher Condition="'$(AetherLauncher)' == ''">false</AetherLauncher>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AetherLauncher</_Parameter1>
      <_Parameter2>$(AetherLauncher)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Aether.png" />
    <AvaloniaResource Include="Themes\Setup.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>
</Project>
